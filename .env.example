# Copiar a .env y completar. NUNCA commitear el .env real.

# PostgreSQL
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/BASE"

# NextAuth: generar con `npx auth secret` u `openssl rand -base64 32`
AUTH_SECRET=""

# Opcional: cuenta de prueba creada por scripts/seed.ts (si faltan, el seed no la crea)
SEED_TEST_EMAIL=""
SEED_TEST_PASSWORD=""

# Opcional: orígenes extra permitidos en dev (separados por coma)
ALLOWED_DEV_ORIGINS=""
